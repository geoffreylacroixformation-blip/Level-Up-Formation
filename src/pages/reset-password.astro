---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../lib/i18n';

const lang = getLangFromUrl(Astro.url);

export const headers = {
  'Content-Security-Policy': "script-src 'self' 'unsafe-inline' https://esm.sh;"
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Reset Password | Level Up Formation" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@500;600;700&display=swap" rel="stylesheet">
    <title>Réinitialisation du mot de passe | Level Up</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Inter', sans-serif;
        background: #0a0a0a;
        min-height: 100vh;
      }

      .auth-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0a0a0a 100%);
        padding: 20px;
      }

      .auth-card {
        width: 100%;
        max-width: 420px;
        background: rgba(15, 15, 26, 0.95);
        border-radius: 24px;
        border: 1px solid rgba(114, 9, 183, 0.3);
        box-shadow: 0 0 60px rgba(114, 9, 183, 0.2);
        padding: 48px 40px;
        text-align: center;
      }

      .brand-logo {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #00ff88, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 8px;
      }

      .brand-sub {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.85rem;
        margin-bottom: 32px;
      }

      .auth-card h3 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.3rem;
        color: #e0e0e0;
        margin-bottom: 16px;
        font-weight: 600;
      }

      .auth-card p {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 24px;
      }

      .auth-input-group {
        width: 100%;
        margin-bottom: 20px;
        text-align: left;
      }

      .auth-input-group label {
        display: block;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.85rem;
        margin-bottom: 8px;
        font-weight: 500;
      }

      .auth-input-group input {
        width: 100%;
        padding: 14px 18px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        color: white;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.3s ease;
      }

      .auth-input-group input:focus {
        outline: none;
        border-color: #7209b7;
        box-shadow: 0 0 20px rgba(114, 9, 183, 0.15);
        background: rgba(114, 9, 183, 0.05);
      }

      .auth-submit-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #7209b7, #00ff88);
        color: white;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 20px rgba(114, 9, 183, 0.3);
        margin-top: 8px;
      }

      .auth-submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(114, 9, 183, 0.5);
      }

      .auth-submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }

      .auth-messages {
        width: 100%;
        margin-top: 16px;
      }

      .auth-error {
        color: #ff6b6b;
        text-align: center;
        font-size: 0.85rem;
        display: none;
        padding: 10px;
        background: rgba(255, 107, 107, 0.08);
        border: 1px solid rgba(255, 107, 107, 0.2);
        border-radius: 8px;
      }

      .auth-success {
        color: #00ff88;
        text-align: center;
        font-size: 0.85rem;
        display: none;
        padding: 10px;
        background: rgba(0, 255, 136, 0.08);
        border: 1px solid rgba(0, 255, 136, 0.2);
        border-radius: 8px;
      }

      .auth-back-link {
        display: block;
        text-align: center;
        margin-top: 24px;
        color: rgba(255, 255, 255, 0.3);
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.3s;
      }

      .auth-back-link:hover {
        color: #00ff88;
      }

      @media (max-width: 480px) {
        .auth-card {
          padding: 32px 24px;
        }
      }
    </style>
  </head>
  <body>
    <main class="auth-container">
      <div class="auth-card">
        <div class="brand-logo">LEVEL UP</div>
        <div class="brand-sub">Réinitialisation du mot de passe</div>
        <h3>Mot de passe oublié ?</h3>
        <p>Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>

        <form id="resetForm">
          <div class="auth-input-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="votre@email.com" autocomplete="email">
          </div>
          <button type="submit" class="auth-submit-btn" id="submitBtn">
            Envoyer le lien de réinitialisation
          </button>
        </form>

        <div class="auth-messages">
          <div class="auth-error" id="errorMsg"></div>
          <div class="auth-success" id="successMsg"></div>
        </div>

        <a href="/membre" class="auth-back-link">← Retour à la connexion</a>
      </div>
    </main>

    <script type="module" src="/supabase-inject.js"></script>
    <script type="module">
      // Credentials injected by workflow into supabase-inject.js (runs first)
      const SUPABASE_URL = window.SUPABASE_URL || '';
      const SUPABASE_ANON_KEY = window.SUPABASE_ANON_KEY || '';
      const resetForm = document.getElementById('resetForm');
      const errorMsg = document.getElementById('errorMsg');
      const successMsg = document.getElementById('successMsg');
      const submitBtn = document.getElementById('submitBtn');

      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        errorMsg.textContent = 'Configuration manquante.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = true;
      }

      resetForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.style.display = 'none';
        successMsg.style.display = 'none';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Envoi en cours...';

        const email = document.getElementById('email').value;

        try {
          const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
          const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
          const { error } = await supabase.auth.resetPasswordForEmail(email, {
            redirectTo: `${window.location.origin}/reset-password`,
          });

          if (error) {
            errorMsg.textContent = error.message;
            errorMsg.style.display = 'block';
          } else {
            successMsg.textContent = 'Lien de réinitialisation envoyé ! Vérifiez votre boîte mail.';
            successMsg.style.display = 'block';
          }
        } catch (err) {
          errorMsg.textContent = 'Erreur lors de l\'envoi du lien.';
          errorMsg.style.display = 'block';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Envoyer le lien de réinitialisation';
        }
      });
    </script>
  </body>
</html>
