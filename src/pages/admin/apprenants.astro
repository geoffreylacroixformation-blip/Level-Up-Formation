---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, defaultLang } from '../../lib/i18n';
const t = useTranslations('fr');
const lang = defaultLang;
---
<Layout title="Apprenants | Admin" lang={lang}>
  <section class="py-12" id="users-admin" style="display: none;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <a href="/admin/" class="text-primary hover:text-primary/80 text-sm mb-2 inline-block">&larr; Retour au dashboard</a>
          <h1 class="font-display text-3xl font-bold">Gestion des Apprenants</h1>
        </div>
        <button id="logout-btn" class="px-4 py-2 bg-surface border border-border text-text-muted rounded-lg hover:text-text transition-colors">
          Déconnexion
        </button>
      </div>

      <!-- Search -->
      <div class="mb-6">
        <input type="text" id="search-input" placeholder="Rechercher par email ou nom..." class="w-full rounded-md bg-background border border-border text-text p-2.5" />
      </div>

      <!-- Users table -->
      <div class="bg-surface rounded-xl border border-border overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-background border-b border-border">
                <th class="px-6 py-3 text-left text-xs font-medium text-text-muted uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-text-muted uppercase tracking-wider">Rôle</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-text-muted uppercase tracking-wider">Cours inscrits</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-text-muted uppercase tracking-wider">Inscrit le</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-text-muted uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody id="users-body" class="divide-y divide-border">
              <tr>
                <td class="px-6 py-4 text-text-muted text-center" colspan="5">Chargement des apprenants...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  function getCookie(name) {
    const match = document.cookie.match(new RegExp('(?:^|;)\\s*' + name + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function getToken() {
    return getCookie('sb-auth-token') || localStorage.getItem('sb-auth-token');
  }

  function logout() {
    localStorage.removeItem('sb-auth-token');
    localStorage.removeItem('sb-auth-user');
    document.cookie = 'sb-auth-token=; path=/; max-age=0';
    window.location.href = '/admin/login';
  }

  // Auth gate
  (async () => {
    const content = document.getElementById('users-admin');
    if (!content) return;

    const token = getToken();
    if (!token) { logout(); return; }

    if (!SUPABASE_URL || !SUPABASE_KEY) {
      content.innerHTML = '<div class="max-w-4xl mx-auto px-4"><p class="text-red-500">Configuration Supabase manquante.</p></div>';
      content.style.display = 'block';
      return;
    }

    try {
      const userStr = localStorage.getItem('sb-auth-user');
      if (!userStr) { logout(); return; }
      const userObj = JSON.parse(userStr);

      const profileRes = await fetch(
        `${SUPABASE_URL}/rest/v1/profiles?id=eq.${userObj.id}&select=role`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        }
      );

      if (!profileRes.ok) { logout(); return; }
      const profileData = await profileRes.json();
      if (profileData.length === 0 || profileData[0].role !== 'admin') { logout(); return; }

      content.style.display = 'block';
      loadUsers();
    } catch (err) {
      console.error('[users-admin] auth error:', err);
      logout();
    }
  })();

  // Load users
  async function loadUsers() {
    const token = getToken();
    if (!token) return;

    const tbody = document.getElementById('users-body');
    const search = document.getElementById('search-input')?.value || '';

    let query = 'select=*,users_courses!inner(course_id,courses!inner(title))';
    if (search) {
      query += `&email=ilike.*${search}*`;
    }
    query += '&order=created_at.desc';

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/profiles?${query}`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        }
      );

      if (!res.ok) {
        tbody.innerHTML = '<tr><td class="px-6 py-4 text-error text-center" colspan="5">Erreur lors du chargement.</td></tr>';
        return;
      }

      const users = await res.json();
      renderUsers(users);
    } catch (err) {
      tbody.innerHTML = '<tr><td class="px-6 py-4 text-error text-center" colspan="5">Erreur: ' + err.message + '</td></tr>';
    }
  }

  function renderUsers(users) {
    const tbody = document.getElementById('users-body');
    if (!tbody) return;

    if (users.length === 0) {
      tbody.innerHTML = '<tr><td class="px-6 py-4 text-text-muted text-center" colspan="5">Aucun apprenant trouvé.</td></tr>';
      return;
    }

    tbody.innerHTML = '';
    users.forEach(user => {
      const tr = document.createElement('tr');
      const roleClass = {
        'admin': 'bg-primary/20 text-primary',
        'user': 'bg-surface text-text-muted'
      }[user.role] || 'bg-surface text-text-muted';

      // Count courses
      const courseCount = user.users_courses?.length || 0;

      tr.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap text-sm">${user.email || 'N/A'}</td>
        <td class="px-6 py-4 whitespace-nowrap">
          <span class="px-2 py-1 text-xs rounded ${roleClass}">${user.role || 'user'}</span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm">${courseCount}</td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-muted">${new Date(user.created_at).toLocaleDateString('fr-FR')}</td>
        <td class="px-6 py-4 whitespace-nowrap text-sm">
          <button class="grant-admin-btn px-3 py-1 bg-primary text-white rounded hover:bg-primary-dark text-xs" data-email="${user.email}">
            Rendre Admin
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Grant admin buttons
    document.querySelectorAll('.grant-admin-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const email = btn.dataset.email;
        if (!confirm(`Donner le rôle admin à ${email} ?`)) return;

        const token = getToken();
        const res = await fetch(
          `${SUPABASE_URL}/rest/v1/profiles?email=eq.${encodeURIComponent(email)}`,
          {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
              'Prefer': 'return=representation'
            },
            body: JSON.stringify({ role: 'admin' })
          }
        );

        if (res.ok) {
          alert('Rôle admin attribué !');
          loadUsers();
        } else {
          alert('Erreur lors de la mise à jour.');
        }
      });
    });
  }

  // Search
  document.getElementById('search-input')?.addEventListener('input', loadUsers);

  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', logout);
</script>
