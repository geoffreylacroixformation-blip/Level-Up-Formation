---
const { slug } = Astro.params;
import Layout from '../../../layouts/Layout.astro';
import { useTranslations, defaultLang } from '../../../lib/i18n';
const t = useTranslations('fr');
const lang = defaultLang;
export async function getStaticPaths() {
  // Will be populated at runtime via fetch
  return [];
}
---
<Layout title={`Cours - ${slug} | Admin`} lang={lang}>
  <section class="py-12" id="course-admin" style="display: none;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <a href="/admin/" class="text-primary hover:text-primary/80 text-sm mb-2 inline-block">&larr; Retour au dashboard</a>
          <h1 class="font-display text-3xl font-bold" id="course-title">Chargement...</h1>
        </div>
        <button id="logout-btn" class="px-4 py-2 bg-surface border border-border text-text-muted rounded-lg hover:text-text transition-colors">
          Déconnexion
        </button>
      </div>

      <!-- Tabs -->
      <div class="flex gap-2 mb-8 border-b border-border">
        <button class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-primary text-text" data-tab="modules">Modules & Leçons</button>
        <button class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-text-muted hover:text-text" data-tab="settings">Paramètres</button>
        <button class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-text-muted hover:text-text" data-tab="students">Apprenants</button>
        <button class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-text-muted hover:text-text" data-tab="resources">Ressources</button>
        <button class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-text-muted hover:text-text" data-tab="preview">Aperçu</button>
      </div>

      <!-- Modules tab -->
      <div class="tab-content" id="tab-modules">
        <div class="bg-surface rounded-xl p-8 border border-border">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold">Modules du cours</h2>
            <button id="add-module-btn" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
              + Ajouter un module
            </button>
          </div>
          <div id="modules-list" class="space-y-4">
            <p class="text-text-muted text-center py-8">Chargement des modules...</p>
          </div>
        </div>
      </div>

      <!-- Settings tab -->
      <div class="tab-content" id="tab-settings" style="display: none;">
        <div class="bg-surface rounded-xl p-8 border border-border">
          <h2 class="text-xl font-semibold mb-6">Paramètres du cours</h2>
          <form id="settings-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-text mb-2">Titre (FR)</label>
                <input type="text" name="title" required class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-2">Title (EN)</label>
                <input type="text" name="titleEn" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-2">Description courte (FR)</label>
              <textarea name="description" rows="3" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-2">Description longue (FR)</label>
              <textarea name="longDescription" rows="5" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <label class="block text-sm font-medium text-text mb-2">Niveau</label>
                <select name="level" class="block w-full rounded-md bg-background border border-border text-text p-2.5">
                  <option value="1">Niveau 1 — Débutant</option>
                  <option value="2">Niveau 2 — Intermédiaire</option>
                  <option value="3">Niveau 3 — Avancé</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-2">Prix (€)</label>
                <input type="number" name="price" step="0.01" min="0" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-2">Catégorie</label>
                <select name="category" class="block w-full rounded-md bg-background border border-border text-text p-2.5">
                  <option value="cybersecurite">Cybersécurité</option>
                  <option value="reseaux">Réseaux</option>
                  <option value="cloud">Cloud</option>
                  <option value="conformite">Conformité</option>
                  <option value="forensique">Forensique</option>
                  <option value="devops">DevOps</option>
                  <option value="autre">Autre</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-2">Image URL</label>
              <input type="text" name="imageUrl" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-text mb-2">Tags (séparés par virgules)</label>
                <input type="text" name="tags" class="block w-full rounded-md bg-background border border-border text-text p-2.5" placeholder="securite, reseaux, firewall" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-2">Compétences (séparées par virgules)</label>
                <input type="text" name="competences" class="block w-full rounded-md bg-background border border-border text-text p-2.5" placeholder="Configurer un firewall, Analyser des logs" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-text mb-2">Public cible</label>
                <input type="text" name="public_cible" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-2">Prérequis</label>
                <textarea name="prerequis" rows="2" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-2">Durée totale (heures)</label>
              <input type="number" name="duree_heures" min="1" class="block w-full rounded-md bg-background border border-border text-text p-2.5" />
            </div>
            <button type="submit" class="w-full py-3 px-4 bg-gradient-to-r from-primary to-primary/80 text-background font-semibold rounded-lg hover:from-primary/90 hover:to-primary/70 transition-all shadow-lg">
              Sauvegarder les paramètres
            </button>
          </form>
        </div>
      </div>

      <!-- Students tab -->
      <div class="tab-content" id="tab-students" style="display: none;">
        <div class="bg-surface rounded-xl p-8 border border-border">
          <h2 class="text-xl font-semibold mb-6">Apprenants inscrits</h2>
          <div id="students-list" class="space-y-3">
            <p class="text-text-muted text-center py-8">Chargement des apprenants...</p>
          </div>
        </div>
      </div>

      <!-- Resources tab -->
      <div class="tab-content" id="tab-resources" style="display: none;">
        <div class="bg-surface rounded-xl p-8 border border-border">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold">Ressources du cours</h2>
            <div class="flex gap-2">
              <button id="upload-resource-btn" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
                + Ajouter une ressource
              </button>
            </div>
          </div>

          <!-- Upload form (hidden by default) -->
          <div id="upload-form-container" class="mb-6" style="display: none;">
            <div class="bg-background border border-border rounded-lg p-6">
              <h3 class="text-lg font-semibold mb-4">Ajouter une ressource</h3>

              <!-- Source selection -->
              <div class="mb-4">
                <label class="block text-sm font-medium text-text mb-2">Source</label>
                <div class="flex gap-4">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="source" value="upload" checked class="accent-primary" />
                    <span class="text-sm">Fichier local</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="source" value="google_docs" class="accent-primary" />
                    <span class="text-sm">Google Docs</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="source" value="google_slides" class="accent-primary" />
                    <span class="text-sm">Google Slides</span>
                  </label>
                </div>
              </div>

              <!-- Title -->
              <div class="mb-4">
                <label class="block text-sm font-medium text-text mb-2">Titre de la ressource</label>
                <input type="text" id="resource-title" class="block w-full rounded-md bg-surface border border-border text-text p-2.5" placeholder="Ex: Fiche de révision — Chapitre 3" />
              </div>

              <!-- Description -->
              <div class="mb-4">
                <label class="block text-sm font-medium text-text mb-2">Description (optionnelle)</label>
                <textarea id="resource-desc" rows="2" class="block w-full rounded-md bg-surface border border-border text-text p-2.5" placeholder="Courte description pour l'élève"></textarea>
              </div>

              <!-- File drop zone -->
              <div id="drop-zone" class="mb-4 border-2 border-dashed border-border rounded-lg p-8 text-center cursor-pointer hover:border-primary transition-colors">
                <input type="file" id="file-input" class="hidden" accept=".pdf,.docx,.pptx,.xlsx,.txt,.zip,.csv" />
                <div id="drop-zone-content">
                  <p class="text-text-muted text-sm mb-2">Glissez un fichier ici ou cliquez pour sélectionner</p>
                  <p class="text-text-muted text-xs">PDF, DOCX, PPTX, XLSX, TXT, ZIP, CSV</p>
                </div>
                <div id="file-selected" class="hidden">
                  <p class="text-primary font-medium" id="file-name"></p>
                  <p class="text-text-muted text-xs" id="file-size"></p>
                </div>
              </div>

              <!-- Google URL (hidden by default) -->
              <div id="google-url-section" class="mb-4" style="display: none;">
                <label class="block text-sm font-medium text-text mb-2">URL Google Docs / Slides</label>
                <input type="url" id="google-url" class="block w-full rounded-md bg-surface border border-border text-text p-2.5" placeholder="https://docs.google.com/..." />
                <p class="text-text-muted text-xs mt-1">Le fichier sera converti en PDF automatiquement.</p>
              </div>

              <!-- Publish toggle -->
              <div class="mb-6">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="resource-published" checked class="accent-primary" />
                  <span class="text-sm">Rendre visible aux élèves</span>
                </label>
              </div>

              <!-- Actions -->
              <div class="flex gap-3">
                <button id="save-resource-btn" class="flex-1 py-3 px-4 bg-gradient-to-r from-primary to-primary/80 text-background font-semibold rounded-lg hover:from-primary/90 hover:to-primary/70 transition-all shadow-lg">
                  Sauvegarder
                </button>
                <button id="cancel-resource-btn" class="px-6 py-3 bg-surface border border-border text-text-muted rounded-lg hover:text-text transition-colors">
                  Annuler
                </button>
              </div>
            </div>
          </div>

          <!-- Resources list -->
          <div id="resources-list" class="space-y-3">
            <p class="text-text-muted text-center py-8">Chargement des ressources...</p>
          </div>
        </div>
      </div>

      <!-- Preview tab -->
      <div class="tab-content" id="tab-preview" style="display: none;">
        <div class="bg-surface rounded-xl p-8 border border-border">
          <h2 class="text-xl font-semibold mb-6">Aperçu du cours</h2>
          <div id="preview-content" class="prose prose-invert max-w-none">
            <p class="text-text-muted text-center py-8">Chargement de l'aperçu...</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- PDF-lib for client-side PDF watermarking -->
<script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const slug = "${slug}";

  function getCookie(name) {
    const match = document.cookie.match(new RegExp('(?:^|;)\\s*' + name + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function getToken() {
    return getCookie('sb-auth-token') || localStorage.getItem('sb-auth-token');
  }

  function logout() {
    localStorage.removeItem('sb-auth-token');
    localStorage.removeItem('sb-auth-user');
    document.cookie = 'sb-auth-token=; path=/; max-age=0';
    window.location.href = '/admin/login';
  }

  // Auth gate
  (async () => {
    const content = document.getElementById('course-admin');
    if (!content) return;

    const token = getToken();
    if (!token) { logout(); return; }

    if (!SUPABASE_URL || !SUPABASE_KEY) {
      content.innerHTML = '<div class="max-w-4xl mx-auto px-4"><p class="text-red-500">Configuration Supabase manquante.</p></div>';
      content.style.display = 'block';
      return;
    }

    try {
      const userStr = localStorage.getItem('sb-auth-user');
      if (!userStr) { logout(); return; }
      const userObj = JSON.parse(userStr);

      const profileRes = await fetch(
        `${SUPABASE_URL}/rest/v1/profiles?id=eq.${userObj.id}&select=role`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        }
      );

      if (!profileRes.ok) { logout(); return; }
      const profileData = await profileRes.json();
      if (profileData.length === 0 || profileData[0].role !== 'admin') { logout(); return; }

      content.style.display = 'block';
      loadCourse();
    } catch (err) {
      console.error('[course-admin] auth error:', err);
      logout();
    }
  })();

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const tab = e.currentTarget.dataset.tab;
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('border-primary', 'text-text');
        b.classList.add('border-transparent', 'text-text-muted');
      });
      e.currentTarget.classList.remove('border-transparent', 'text-text-muted');
      e.currentTarget.classList.add('border-primary', 'text-text');
      document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
      document.getElementById(`tab-${tab}`).style.display = 'block';
    });
  });

  // Load course data
  let currentCourse = null;

  async function loadCourse() {
    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/courses?slug=eq.${encodeURIComponent(slug)}&select=*`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        }
      );

      if (!res.ok) {
        document.getElementById('course-title').textContent = 'Cours non trouvé';
        return;
      }

      const courses = await res.json();
      if (courses.length === 0) {
        document.getElementById('course-title').textContent = 'Cours non trouvé';
        return;
      }

      currentCourse = courses[0];
      document.getElementById('course-title').textContent = currentCourse.title;

      // Load modules
      loadModules();

      // Load settings
      loadSettings();

      // Load students
      loadStudents();

      // Load resources
      loadResources();

      // Load preview
      loadPreview();
    } catch (err) {
      console.error('[course-admin] load error:', err);
    }
  }

  // Module management
  function loadModules() {
    const container = document.getElementById('modules-list');
    if (!container || !currentCourse) return;

    const modules = currentCourse.modules || [];
    if (modules.length === 0) {
      container.innerHTML = '<p class="text-text-muted text-center py-8">Aucun module. Cliquez sur "Ajouter un module" pour commencer.</p>';
      return;
    }

    container.innerHTML = '';
    modules.forEach((mod, idx) => {
      const div = document.createElement('div');
      div.className = 'module-item bg-background border border-border rounded-lg p-6';
      div.innerHTML = `
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-text-muted bg-surface px-3 py-1 rounded">Module ${idx + 1}</span>
            <h3 class="font-semibold text-lg">${mod.title || 'Sans titre'}</h3>
            ${mod.isFree ? '<span class="text-xs bg-success/20 text-success px-2 py-0.5 rounded">Gratuit</span>' : ''}
          </div>
          <div class="flex gap-2">
            <button class="edit-module-btn px-3 py-1 bg-surface border border-border text-text-muted rounded hover:text-text text-sm" data-idx="${idx}">Modifier</button>
            <button class="delete-module-btn px-3 py-1 bg-error text-white rounded hover:bg-error/80 text-sm" data-idx="${idx}">Supprimer</button>
          </div>
        </div>
        <p class="text-text-muted text-sm mb-3">${mod.description || 'Pas de description'}</p>
        <div class="flex gap-4 text-sm text-text-muted">
          <span>Durée: ${mod.duration || 'Non définie'}</span>
          <span>Ordre: ${mod.order ?? idx}</span>
        </div>
      `;
      container.appendChild(div);

      div.querySelector('.delete-module-btn').addEventListener('click', () => deleteModule(idx));
      div.querySelector('.edit-module-btn').addEventListener('click', () => editModule(idx));
    });
  }

  document.getElementById('add-module-btn')?.addEventListener('click', () => {
    if (!currentCourse) return;
    const modules = currentCourse.modules || [];
    modules.push({
      id: `mod-${Date.now()}`,
      title: 'Nouveau module',
      titleEn: 'New Module',
      description: '',
      descriptionEn: '',
      isFree: false,
      order: modules.length,
      duration: '1h',
      lessons: []
    });
    currentCourse.modules = modules;

    // Save to Supabase
    saveModules();
  });

  async function saveModules() {
    const token = getToken();
    if (!token || !currentCourse) return;

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/courses?id=eq.${currentCourse.id}`,
        {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=representation'
          },
          body: JSON.stringify({ modules: currentCourse.modules })
        }
      );

      if (!res.ok) throw new Error('Échec de la sauvegarde');
      loadModules();
    } catch (err) {
      alert(`Erreur: ${err.message}`);
    }
  }

  function editModule(idx) {
    if (!currentCourse || !currentCourse.modules[idx]) return;
    const mod = currentCourse.modules[idx];

    const newTitle = prompt('Titre du module:', mod.title);
    if (newTitle === null) return;
    mod.title = newTitle;

    const newDesc = prompt('Description:', mod.description || '');
    if (newDesc === null) return;
    mod.description = newDesc;

    const newDuration = prompt('Durée (ex: 1h30):', mod.duration || '1h');
    if (newDuration === null) return;
    mod.duration = newDuration;

    const isFree = confirm('Ce module est-il gratuit ?');
    mod.isFree = isFree;

    currentCourse.modules[idx] = mod;
    saveModules();
  }

  async function deleteModule(idx) {
    if (!confirm('Supprimer ce module ?')) return;
    currentCourse.modules.splice(idx, 1);
    // Renumber
    currentCourse.modules.forEach((m, i) => m.order = i);
    saveModules();
  }

  // Settings
  function loadSettings() {
    if (!currentCourse) return;
    const form = document.getElementById('settings-form');
    if (!form) return;

    form.querySelector('[name="title"]').value = currentCourse.title || '';
    form.querySelector('[name="titleEn"]').value = currentCourse.title_en || '';
    form.querySelector('[name="description"]').value = currentCourse.description || '';
    form.querySelector('[name="longDescription"]').value = currentCourse.long_description || '';
    form.querySelector('[name="level"]').value = currentCourse.level || 1;
    form.querySelector('[name="price"]').value = currentCourse.price ?? 0;
    form.querySelector('[name="category"]').value = currentCourse.category || 'cybersecurite';
    form.querySelector('[name="imageUrl"]').value = currentCourse.image || '';
    form.querySelector('[name="tags"]').value = (currentCourse.tags || []).join(', ');
    form.querySelector('[name="competences"]').value = (currentCourse.competences || []).join(', ');
    form.querySelector('[name="public_cible"]').value = currentCourse.public_cible || '';
    form.querySelector('[name="prerequis"]').value = currentCourse.prerequis || '';
    form.querySelector('[name="duree_heures"]').value = currentCourse.duree_heures || '';
  }

  document.getElementById('settings-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentCourse) return;

    const formData = new FormData(e.target);
    const level = parseInt(formData.get('level'));
    const niveauMap = { 1: 'LVL1', 2: 'LVL2', 3: 'LVL3' };

    const updateData = {
      title: formData.get('title'),
      title_en: formData.get('titleEn') || null,
      description: formData.get('description'),
      long_description: formData.get('longDescription') || null,
      level: level,
      niveau: niveauMap[level],
      price: parseFloat(formData.get('price')),
      modules: currentCourse.modules,
      image: formData.get('imageUrl') || null,
      tags: formData.get('tags')?.split(',').map(t => t.trim()).filter(Boolean) || [],
      category: formData.get('category') || 'cybersecurite',
      competences: formData.get('competences')?.split(',').map(c => c.trim()).filter(Boolean) || [],
      public_cible: formData.get('public_cible') || null,
      prerequis: formData.get('prerequis') || null,
      duree_heures: parseInt(formData.get('duree_heures')) || null
    };

    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/courses?id=eq.${currentCourse.id}`,
        {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=representation'
          },
          body: JSON.stringify(updateData)
        }
      );

      if (!res.ok) throw new Error('Échec de la sauvegarde');

      alert('Paramètres sauvegardés avec succès !');
      loadCourse();
    } catch (err) {
      alert(`Erreur: ${err.message}`);
    }
  });

  // Students
  async function loadStudents() {
    const container = document.getElementById('students-list');
    if (!container) return;

    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/users_courses?course_id=eq.${currentCourse.id}&select=*,profiles!users_courses_user_id_fkey(email,role)`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        }
      );

      if (!res.ok) {
        container.innerHTML = '<p class="text-text-muted text-center py-8">Aucun apprenant inscrit.</p>';
        return;
      }

      const students = await res.json();
      if (students.length === 0) {
        container.innerHTML = '<p class="text-text-muted text-center py-8">Aucun apprenant inscrit.</p>';
        return;
      }

      container.innerHTML = '';
      students.forEach(student => {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between bg-background border border-border rounded-lg p-4';
        const email = student.profiles?.email || 'Inconnu';
        const progress = student.progress || 0;
        div.innerHTML = `
          <div>
            <h3 class="font-semibold">${email}</h3>
            <p class="text-text-muted text-sm">Progression: ${progress}%</p>
          </div>
          <div class="text-right">
            <span class="text-xs bg-success/20 text-success px-2 py-0.5 rounded">${progress}% complété</span>
          </div>
        `;
        container.appendChild(div);
      });
    } catch (err) {
      container.innerHTML = '<p class="text-error text-center py-8">Erreur lors du chargement.</p>';
    }
  }

  // Preview
  function loadPreview() {
    const container = document.getElementById('preview-content');
    if (!container || !currentCourse) return;

    container.innerHTML = `
      <h3>${currentCourse.title}</h3>
      <p>${currentCourse.description || ''}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
        <div>
          <h4>Modules:</h4>
          <ul>
            ${(currentCourse.modules || []).map((m, i) => `<li>Module ${i + 1}: ${m.title} (${m.duration})</li>`).join('')}
          </ul>
        </div>
        <div>
          <h4>Informations:</h4>
          <ul>
            <li><strong>Niveau:</strong> ${currentCourse.level || 'Non défini'}</li>
            <li><strong>Prix:</strong> ${currentCourse.price || 0}€</li>
            <li><strong>Catégorie:</strong> ${currentCourse.category || 'Non définie'}</li>
            <li><strong>Durée:</strong> ${currentCourse.duree_heures || 'Non définie'}h</li>
          </ul>
        </div>
      </div>
    `;
  }

  // ============================================================
  // RESOURCES MANAGEMENT
  // ============================================================
  let currentResources = [];

  async function loadResources() {
    const container = document.getElementById('resources-list');
    if (!container || !currentCourse) return;

    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/materials?course_id=eq.${currentCourse.id}&order=sort_order.asc&is_published=eq.true&select=*`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        }
      );

      if (!res.ok) {
        container.innerHTML = '<p class="text-text-muted text-center py-8">Aucune ressource disponible.</p>';
        return;
      }

      currentResources = await res.json();

      if (currentResources.length === 0) {
        container.innerHTML = '<p class="text-text-muted text-center py-8">Aucune ressource. Cliquez sur "Ajouter une ressource" pour en ajouter une.</p>';
        return;
      }

      container.innerHTML = '';
      currentResources.forEach((res, idx) => {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between bg-background border border-border rounded-lg p-4';
        const typeIcons = {
          google_docs: '📄',
          google_slides: '📊',
          pdf: '📕',
          docx: '📘',
          pptx: '📙',
          xlsx: '📗',
          zip: '📦',
          other: '📎'
        };
        const icon = typeIcons[res.file_type] || '📎';
        const sizeStr = res.file_size ? formatFileSize(res.file_size) : '';
        div.innerHTML = `
          <div class="flex items-center gap-4 flex-1">
            <span class="text-2xl">${icon}</span>
            <div>
              <h3 class="font-semibold">${res.title}</h3>
              <p class="text-text-muted text-sm">${res.original_filename || res.file_type}${sizeStr ? ' — ' + sizeStr : ''}</p>
              ${res.description ? `<p class="text-text-muted text-xs mt-1">${res.description}</p>` : ''}
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs text-text-muted">${res.download_count} téléchargements</span>
            <a href="${res.pdf_url || res.file_url}" target="_blank" class="px-3 py-1.5 bg-primary/20 text-primary border border-primary/30 rounded-lg hover:bg-primary/30 transition-colors text-sm">
              Télécharger
            </a>
          </div>
        `;
        container.appendChild(div);
      });
    } catch (err) {
      container.innerHTML = '<p class="text-error text-center py-8">Erreur lors du chargement des ressources.</p>';
    }
  }

  function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + ' o';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' Ko';
    return (bytes / 1048576).toFixed(1) + ' Mo';
  }

  // Upload form toggle
  document.getElementById('upload-resource-btn')?.addEventListener('click', () => {
    const form = document.getElementById('upload-form-container');
    form.style.display = 'block';
    form.scrollIntoView({ behavior: 'smooth' });
  });

  document.getElementById('cancel-resource-btn')?.addEventListener('click', () => {
    document.getElementById('upload-form-container').style.display = 'none';
    resetUploadForm();
  });

  // Source radio buttons toggle
  document.querySelectorAll('input[name="source"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const isGoogle = e.target.value !== 'upload';
      document.getElementById('drop-zone').style.display = isGoogle ? 'none' : 'block';
      document.getElementById('google-url-section').style.display = isGoogle ? 'block' : 'none';
    });
  });

  // File drop zone
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');

  dropZone?.addEventListener('click', () => fileInput?.click());

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-primary');
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-primary');
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-primary');
    const files = e.dataTransfer.files;
    if (files.length > 0) {
      handleFileSelect(files[0]);
    }
  });

  fileInput?.addEventListener('change', (e) => {
    if (e.target.files.length > 0) {
      handleFileSelect(e.target.files[0]);
    }
  });

  function handleFileSelect(file) {
    document.getElementById('file-name').textContent = file.name;
    document.getElementById('file-size').textContent = formatFileSize(file.size);
    document.getElementById('drop-zone-content').classList.add('hidden');
    document.getElementById('file-selected').classList.remove('hidden');
    window._selectedFile = file;
  }

  function resetUploadForm() {
    document.getElementById('resource-title').value = '';
    document.getElementById('resource-desc').value = '';
    document.getElementById('google-url').value = '';
    document.getElementById('resource-published').checked = true;
    fileInput.value = '';
    document.getElementById('drop-zone-content').classList.remove('hidden');
    document.getElementById('file-selected').classList.add('hidden');
    window._selectedFile = null;
    document.querySelector('input[name="source"][value="upload"]').checked = true;
    document.getElementById('drop-zone').style.display = 'block';
    document.getElementById('google-url-section').style.display = 'none';
  }

  // Save resource
  document.getElementById('save-resource-btn')?.addEventListener('click', async () => {
    const token = getToken();
    if (!token || !currentCourse) return;

    const title = document.getElementById('resource-title').value.trim();
    const description = document.getElementById('resource-desc').value.trim();
    const source = document.querySelector('input[name="source"]:checked').value;
    const isPublished = document.getElementById('resource-published').checked;

    if (!title) {
      alert('Veuillez entrer un titre.');
      return;
    }

    let fileUrl = '';
    let pdfUrl = null;
    let fileType = 'other';
    let originalFilename = null;
    let fileSize = null;

    if (source === 'upload') {
      const file = window._selectedFile;
      if (!file) {
        alert('Veuillez sélectionner un fichier.');
        return;
      }

      // Upload to Supabase Storage
      fileUrl = await uploadToStorage(file);
      if (!fileUrl) {
        alert('Erreur lors du téléchargement du fichier.');
        return;
      }

      originalFilename = file.name;
      fileSize = file.size;

      // Determine file type
      const ext = file.name.split('.').pop().toLowerCase();
      const typeMap = {
        pdf: 'pdf', docx: 'docx', doc: 'docx',
        pptx: 'pptx', ppt: 'pptx',
        xlsx: 'xlsx', xls: 'xlsx',
        zip: 'zip', txt: 'other', csv: 'other'
      };
      fileType = typeMap[ext] || 'other';

      // Generate PDF with watermark (client-side for PDF, server-side for others)
      if (ext === 'pdf') {
        pdfUrl = await applyWatermark(file);
      } else {
        // For non-PDF files, we'll generate PDF server-side via a Supabase Edge Function
        pdfUrl = null; // Will be filled by the edge function
      }
    } else {
      // Google Docs / Slides
      const googleUrl = document.getElementById('google-url').value.trim();
      if (!googleUrl) {
        alert('Veuillez entrer une URL Google Docs / Slides.');
        return;
      }

      fileType = source;
      fileUrl = googleUrl;

      // Generate PDF from Google Docs/Slides via Google API (export)
      pdfUrl = await exportGoogleToPdf(googleUrl, source);
      if (!pdfUrl) {
        alert('Erreur lors de la conversion du fichier Google.');
        return;
      }
    }

    // Save to Supabase
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/materials`, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify({
          course_id: currentCourse.id,
          title,
          description: description || null,
          file_type: fileType,
          file_url: fileUrl,
          pdf_url: pdfUrl,
          original_filename: originalFilename,
          file_size: fileSize,
          is_published: isPublished,
          sort_order: currentResources.length
        })
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.message || 'Échec de la sauvegarde');
      }

      alert('Ressource ajoutée avec succès !');
      document.getElementById('upload-form-container').style.display = 'none';
      resetUploadForm();
      loadResources();
    } catch (err) {
      alert(`Erreur: ${err.message}`);
    }
  });

  // Upload file to Supabase Storage
  async function uploadToStorage(file) {
    const token = getToken();
    const folder = currentCourse.slug;
    const fileName = `${Date.now()}-${file.name}`;
    const path = `materials/${folder}/${fileName}`;

    const res = await fetch(
      `${SUPABASE_URL}/storage/v1/object/materials/${folder}/${fileName}`,
      {
        method: 'PUT',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${token}`,
          'Content-Type': file.type || 'application/octet-stream'
        },
        body: file
      }
    );

    if (!res.ok) {
      console.error('[upload] Storage error:', res.status, res.statusText);
      return null;
    }

    // Get public URL
    const urlRes = await fetch(
      `${SUPABASE_URL}/storage/v1/object/public/materials/${folder}/${fileName}`,
      {
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${token}`
        }
      }
    );

    if (urlRes.ok) {
      return `${SUPABASE_URL}/storage/v1/object/public/materials/${folder}/${fileName}`;
    }

    return `${SUPABASE_URL}/storage/v1/object/materials/${folder}/${fileName}`;
  }

  // Apply watermark to PDF
  async function applyWatermark(file) {
    // Client-side PDF watermark using PDF-lib
    const arrayBuffer = await file.arrayBuffer();
    const pdfDoc = await PDFLib.PDFDocument.load(arrayBuffer);
    const pages = pdfDoc.getPages();
    const { width, height } = pages[0].getSize();

    // Embed font for watermark text
    const font = await pdfDoc.embedFont(PDFLib.StandardFonts.Helvetica);
    const fontSize = Math.max(40, Math.min(width, height) / 10);
    const textColor = PDFLib.rgb(0.15, 0.15, 0.15);

    for (const page of pages) {
      page.drawText('Level Up Formation — Document protégé', {
        x: width / 2 - (fontSize * 20),
        y: height / 2,
        size: fontSize,
        font,
        color: textColor,
        opacity: 0.3,
        rotate: PDFLib.degrees(45),
      });
    }

    const watermarkPdfBytes = await pdfDoc.save();
    const watermarkFile = new Blob([watermarkPdfBytes], { type: 'application/pdf' });

    // Upload watermarked PDF
    const watermarkedFile = new File([watermarkFile], `watermarked-${file.name}`, { type: 'application/pdf' });
    return uploadToStorage(watermarkedFile);
  }

  // Export Google Docs/Slides to PDF via Google API
  async function exportGoogleToPdf(googleUrl, type) {
    // For now, use Google's export URL format
    // In production, this should use the Google Drive API via Composio
    const fileId = extractGoogleFileId(googleUrl);
    if (!fileId) {
      console.error('[google-export] Invalid Google URL');
      return null;
    }

    // Generate a temporary export link
    // This will be replaced with a proper server-side export via Google API
    const exportUrl = `https://docs.google.com/${type === 'google_docs' ? 'document/d/${fileId}/export' : 'presentation/d/${fileId}/export'}?format=pdf`;

    // For now, return the export URL directly
    // In production: download PDF → apply watermark → upload to storage
    return exportUrl;
  }

  function extractGoogleFileId(url) {
    const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
    return match ? match[1] : null;
  }

  // Load resources when course loads
  // (added to loadCourse function below)
  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', logout);
</script>
