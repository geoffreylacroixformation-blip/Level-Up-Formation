---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);

export const headers = {
  'Content-Security-Policy': "script-src 'self' 'unsafe-inline' https://esm.sh;"
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Admin - Level Up Formation" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@500;600;700&display=swap" rel="stylesheet">
    <title>Admin Login | Level Up</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Inter', sans-serif;
        background: #0a0a0a;
        min-height: 100vh;
      }

      .auth-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0a0a0a 100%);
        padding: 20px;
      }

      .auth-card {
        width: 100%;
        max-width: 900px;
        min-height: 500px;
        display: flex;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 0 60px rgba(114, 9, 183, 0.2), 0 0 120px rgba(0, 255, 136, 0.05);
        border: 1px solid rgba(114, 9, 183, 0.3);
      }

      /* --- Left panel (overlay) --- */
      .auth-overlay {
        width: 45%;
        background: linear-gradient(135deg, #1a1a2e 0%, #2d1b69 50%, #0f0f1a 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 32px;
        position: relative;
        z-index: 2;
      }

      .auth-overlay::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background:
          radial-gradient(circle at 30% 20%, rgba(0, 255, 136, 0.08) 0%, transparent 50%),
          radial-gradient(circle at 70% 80%, rgba(114, 9, 183, 0.12) 0%, transparent 50%);
        pointer-events: none;
      }

      .auth-overlay-content {
        position: relative;
        z-index: 1;
        text-align: center;
      }

      .auth-overlay h2 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #00ff88;
        margin-bottom: 16px;
        text-shadow: 0 0 20px rgba(0, 255, 136, 0.4);
      }

      .auth-overlay p {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 32px;
      }

      .auth-overlay .back-btn {
        padding: 12px 32px;
        border: 2px solid #00ff88;
        border-radius: 12px;
        background: transparent;
        color: #00ff88;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        letter-spacing: 0.5px;
      }

      .auth-overlay .back-btn:hover {
        background: rgba(0, 255, 136, 0.1);
        box-shadow: 0 0 25px rgba(0, 255, 136, 0.3);
        transform: translateY(-2px);
      }

      /* --- Right panel (form) --- */
      .auth-form-panel {
        flex: 1;
        background: rgba(15, 15, 26, 0.95);
        backdrop-filter: blur(20px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 40px;
      }

      .auth-form-panel .brand-logo {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #00ff88, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 8px;
      }

      .auth-form-panel .brand-sub {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.85rem;
        margin-bottom: 36px;
      }

      .auth-form-panel h3 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.3rem;
        color: #e0e0e0;
        margin-bottom: 32px;
        font-weight: 600;
      }

      .auth-input-group {
        width: 100%;
        max-width: 320px;
        margin-bottom: 20px;
      }

      .auth-input-group label {
        display: block;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.85rem;
        margin-bottom: 8px;
        font-weight: 500;
      }

      .auth-input-group input {
        width: 100%;
        padding: 14px 18px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        color: white;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.3s ease;
      }

      .auth-input-group input:focus {
        outline: none;
        border-color: #7209b7;
        box-shadow: 0 0 20px rgba(114, 9, 183, 0.15);
        background: rgba(114, 9, 183, 0.05);
      }

      .auth-input-group input::placeholder {
        color: rgba(255, 255, 255, 0.2);
      }

      .auth-submit-btn {
        width: 100%;
        max-width: 320px;
        padding: 14px;
        border: none;
        border-radius: 12px;
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 8px;
        background: linear-gradient(135deg, #7209b7, #00ff88);
        color: white;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 20px rgba(114, 9, 183, 0.3);
      }

      .auth-submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(114, 9, 183, 0.5);
      }

      .auth-submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }

      .auth-messages {
        width: 100%;
        max-width: 320px;
        margin-top: 16px;
      }

      .auth-error {
        color: #ff6b6b;
        text-align: center;
        font-size: 0.85rem;
        display: none;
        padding: 10px;
        background: rgba(255, 107, 107, 0.08);
        border: 1px solid rgba(255, 107, 107, 0.2);
        border-radius: 8px;
      }

      .auth-success {
        color: #00ff88;
        text-align: center;
        font-size: 0.85rem;
        display: none;
        padding: 10px;
        background: rgba(0, 255, 136, 0.08);
        border: 1px solid rgba(0, 255, 136, 0.2);
        border-radius: 8px;
      }

      .auth-back-link {
        display: block;
        text-align: center;
        margin-top: 24px;
        color: rgba(255, 255, 255, 0.3);
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.3s;
      }

      .auth-back-link:hover {
        color: #00ff88;
      }

      /* --- Responsive --- */
      @media (max-width: 768px) {
        .auth-card {
          flex-direction: column;
          max-width: 420px;
        }

        .auth-overlay {
          width: 100%;
          padding: 32px 24px;
          min-height: auto;
        }

        .auth-overlay h2 {
          font-size: 1.3rem;
        }

        .auth-overlay p {
          font-size: 0.85rem;
          margin-bottom: 20px;
        }

        .auth-form-panel {
          padding: 32px 24px;
        }
      }
    </style>
  </head>
  <body>
    <main class="auth-container">
      <div class="auth-card">
        <!-- Left panel -->
        <div class="auth-overlay">
          <div class="auth-overlay-content">
            <h2>Level Up</h2>
            <p>Accès réservé aux administrateurs de la plateforme. Veuillez vous identifier pour continuer.</p>
            <button class="back-btn" onclick="window.location.href='/Level-Up-Formation/'">← Retour au site</button>
          </div>
        </div>

        <!-- Right panel (form) -->
        <div class="auth-form-panel">
          <div class="brand-logo">LEVEL UP</div>
          <div class="brand-sub">Administration</div>
          <h3>Connexion</h3>

          <form id="loginForm">
            <div class="auth-input-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="votre@email.com" autocomplete="email">
            </div>
            <div class="auth-input-group">
              <label for="password">Mot de passe</label>
              <input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password">
            </div>
            <button type="submit" class="auth-submit-btn" id="submitBtn">
              Se connecter
            </button>
          </form>

          <div class="auth-messages">
            <div class="auth-error" id="errorMsg"></div>
            <div class="auth-success" id="successMsg"></div>
            <div class="config-warning" id="configWarning" style="display:none; color: #f59e0b; text-align: center; font-size: 0.85rem; padding: 10px; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 8px; margin-top: 16px;">Configuration Supabase manquante.</div>
          </div>

          <a href="/Level-Up-Formation/" class="auth-back-link">← Retour au site</a>

          <a href="#" class="auth-back-link" id="forgot-password-link" style="margin-top:8px;">Mot de passe oublié ?</a>
        </div>
      </div>
    </main>

    <script type="module" src={Astro.base + '/assets/admin-login.js'}></script>
  </body>
</html>
